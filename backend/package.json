{
  "name": "alevel-smart-practice-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for A-Level Smart Practice",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:biology-pilot": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/biology-chapter-pilot.sql",
    "db:biology-pilot-reviewed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/biology-chapter-pilot-reviewed.sql",
    "db:biology-full-curriculum": "node scripts/seed-biology-full-curriculum.mjs",
    "db:biology-full-mappings": "node scripts/generate-biology-full-mappings.mjs",
    "catalog:migrate": "node scripts/migrate-exam-catalog.mjs",
    "import:pdf-bank": "node scripts/import-pdf-bank.mjs",
    "import:chemis-all": "node scripts/import-all-chemis-pdfs.mjs",
    "import:coordinated-sciences": "node scripts/import-coordinated-sciences-to-db.mjs",
    "import:bank-db": "node scripts/import-bank-to-db.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.13.1"
  }
}
