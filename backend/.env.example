PORT=3001
NODE_ENV=development

# Set this to enable PostgreSQL mode.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/alevel_smart_practice

# Optional: set true for managed PostgreSQL requiring SSL.
DB_SSL=false

# If true, server exits when DB connection fails.
DB_REQUIRED=false

# Supabase Auth with the Google provider. The redirect URL must also be listed
# in Supabase Authentication > URL Configuration > Redirect URLs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_AUTH_REDIRECT_URL=https://your-domain.example/alevel/pages/login.html

# Use review while running npm run hints:biology-sample. Switch to live only
# after the admin panel reports 24/24 approved; the server enforces this gate.
AI_HINT_MODE=disabled
OPENAI_API_KEY=
OPENAI_HINT_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
