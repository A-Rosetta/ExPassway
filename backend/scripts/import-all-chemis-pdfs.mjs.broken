import fs from 'node:fs/promises';
import path from 'node:path';

const INPUT_DIR = '/home/ubuntu/chemis/pdf';
const TXT_DIR = '/home/ubuntu/chemis/txt';
const OUTPUT = '/home/ubuntu/alevel-smart-practice/backend/src/data/importedQuestionBank.json';
const IMAGE_MAP_BY_FILE = {
  '0620_s23_qp_21.pdf': '/home/ubuntu/alevel-smart-practice/backend/scripts/image-map.full.json'
};

function normalize(s) {
  return String(s || '').replace(/\r/g, ' ').replace(/\s+/g, ' ').trim();
}

function cleanupPaperText(raw) {
  return normalize(
    String(raw || '')
      .replace(/=== PAGE \d+ ===/g, ' ')
      .replace(/© UCLES 2023/g, ' ')
      .replace(/\[Turn over/g, ' ')
      .replace(/BLANK PAGE/g, ' ')
      .replace(/Group\s+The Periodic Table of Elements[\s\S]*$/i, ' ')
  );
}

function extractByQnum(full, q) {
  const startRe = q === 1
    ? /\s1\s{1,}(?=The\sdiagram|Four\sphysical\schanges|Which\srow|What\sis|An\satom|A\sgas|Hydrogen|A\smixture|Which\sstatement|Dilute)/i
    : new RegExp(`\\s${q}\\s{1,}`);
  const s = full.search(startRe);
  if (s < 0) return '';
  const from = s + String(q).length + 1;
  if (q === 40) return full.slice(from);
  const endRe = new RegExp(`\\s${q + 1}\\s{1,}`);
  const rest = full.slice(from);
  const e = rest.search(endRe);
  return e < 0 ? rest : rest.slice(0, e);
}

function parseSeg(seg) {
  const t = normalize(seg);
  const idxA = t.search(/\sA\s{1,}/);
  const idxB = t.search(/\sB\s{1,}/);
  const idxC = t.search(/\sC\s{1,}/);
  const idxD = t.search(/\sD\s{1,}/);
  if ([idxA, idxB, idxC, idxD].some((x) => x < 0)) return null;
  if (!(idxA < idxB && idxB < idxC && idxC < idxD)) return null;

  const stem = normalize(t.slice(0, idxA));
  const a = normalize(t.slice(idxA + 2, idxB));
  const b = normalize(t.slice(idxB + 2, idxC));
  const c = normalize(t.slice(idxC + 2, idxD));
  const d = normalize(t.slice(idxD + 2));
  if (!stem || !a || !b || !c || !d) return null;
  return { stem, options: [a, b, c, d] };
}

function parseYearAndPaperLabel(fileName) {
  const m = fileName.match(/^0620_([sw])(\d{2})_qp_(\d{2})/i);
  if (!m) return { year: 'Unknown', season: '', paperCode: '' };
  const season = m[1].toLowerCase() === 's' ? 'Past Paper Summer' : 'Past Paper Winter';
  const year = String(2000 + Number(m[2]));
  return { year, season, paperCode: m[3] };
}

async function maybeReadImageMap(fileName) {
  const mapPath = IMAGE_MAP_BY_FILE[fileName];
  if (!mapPath) return {};
  try {
    return JSON.parse(await fs.readFile(mapPath, 'utf8'));
  } catch {
    return {};
  }
}

async function parseFromTxt(fileName) {
  const txtPath = path.join(TXT_DIR, fileName.replace(/\.pdf$/i, '.txt'));
  const raw = await fs.readFile(txtPath, 'utf8');
  const full = cleanupPaperText(raw);
  const out = [];
  for (let q = 1; q <= 40; q += 1) {
    const seg = extractByQnum(full, q);
    const parsed = parseSeg(seg);
    if (!parsed) continue;
    out.push({ number: q, ...parsed, parsed: true });
  }
  return out;
}

async function main() {
  const files = (await fs.readdir(INPUT_DIR)).filter((f) => f.toLowerCase().endsWith('.pdf')).sort();
  const all = [];

  for (const fileName of files) {
    const meta = parseYearAndPaperLabel(fileName);
    const imageMap = await maybeReadImageMap(fileName);
    const parsed = await parseFromTxt(fileName);

    for (const q of parsed) {
      all.push({
        id: `CIE-IGCHEM-${meta.year}-${meta.paperCode}-${String(q.number).padStart(2, '0')}`,
        board: 'CIE',
        subject: 'IGCSE Chemistry',
        paper: 'MCQ',
        difficulty: q.number <= 14 ? '基础' : q.number <= 28 ? '中等' : '冲刺',
        topic: meta.season,
        year: meta.year,
        stem: q.stem,
        options: q.options,
        answer: 0,
        mistakeType: 'unknown',
        templateId: `${meta.year}-${meta.paperCode}-${q.number}`,
        skills: [],
        hints: [],
        images: Array.isArray(imageMap[String(q.number)])
          ? imageMap[String(q.number)].map((url, idx) => ({ url: String(url), position: 'stem', order: idx + 1 }))
          : [],
        source: {
          type: 'txt_import',
          fileName,
          questionNo: q.number,
          optionsParsed: true,
          year: meta.year,
          season: meta.season,
          importedAt: new Date().toISOString()
        }
      });
    }
    console.log(`parsed ${fileName}: ${parsed.length} questions`);
  }

  await fs.writeFile(OUTPUT, JSON.stringify(all, null, 2), 'utf8');
  console.log(`total imported questions: ${all.length}`);
  console.log(`output: ${OUTPUT}`);
}

main().catch((e) => {
  console.error(e);
  process.exit(1);
});
