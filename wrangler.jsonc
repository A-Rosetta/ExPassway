{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "expassway",
	"main": "cloudflare/worker.js",
	"compatibility_date": "2026-07-30",
	"workers_dev": true,
	"vars": {
		"SUPABASE_AUTH_REDIRECT_URL": "https://expassway.rosettaclient.workers.dev/pages/login.html"
	},
	"assets": {
		"directory": "./.cloudflare-dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/",
			"/api/*"
		],
		"html_handling": "none"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "expassway-db",
			"database_id": "a6122247-fef0-4da3-9d35-f2cdd43423cf"
		}
	],
	"r2_buckets": [
		{
			"binding": "CONTENT_BUCKET",
			"bucket_name": "expassway-content"
		},
		{
			"binding": "PRIVATE_IMPORTS_BUCKET",
			"bucket_name": "expassway-private-imports"
		}
	]
}
