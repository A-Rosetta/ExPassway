{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "expassway",
	"main": "cloudflare/worker.js",
	"compatibility_date": "2026-07-30",
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"SUPABASE_AUTH_REDIRECT_URL": "https://expassway.com/pages/login.html",
		"OPENAI_HINT_MODEL": "gpt-5.6-luna",
		"OPENAI_API_BASE_URL": "https://www.rayinai.com",
		"CHAT_ENABLED": "true",
		"CHAT_ACCOUNT_V2_ENABLED": "false",
		"CHAT_LEGACY_V1_READ_ENABLED": "true",
		"CHAT_LEGACY_V1_SEND_ENABLED": "true",
		"CHAT_RECOVERY_BACKUP_ENABLED": "false"
	},
	"assets": {
		"directory": "./.cloudflare-dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "none"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "expassway-db",
			"database_id": "a6122247-fef0-4da3-9d35-f2cdd43423cf"
		}
	],
	"r2_buckets": [
		{
			"binding": "CONTENT_BUCKET",
			"bucket_name": "expassway-content"
		},
		{
			"binding": "PRIVATE_IMPORTS_BUCKET",
			"bucket_name": "expassway-private-imports"
		},
		{
			"binding": "CHAT_MEDIA_BUCKET",
			"bucket_name": "expassway-chat-media"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOMS",
				"class_name": "ChatRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "chat-room-v1",
			"new_sqlite_classes": ["ChatRoom"]
		}
	],
	"triggers": {
		"crons": ["*/15 * * * *"]
	}
}
